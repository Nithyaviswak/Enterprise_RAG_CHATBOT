# ── App Settings ──────────────────────────────────────────────
APP_NAME=RAG Chatbot
APP_VERSION=1.0.0
DEBUG=false
RAG_DEBUG_MODE=false          # expose retrieval internals to the API (dev only)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Google Gemini API ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048

# ── RAGFlow (Plugin) ──────────────────────────────────────────
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=your_ragflow_api_key_here

# ── Embedding Model (Plugin: sentence-transformers) ───────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
FINETUNED_MODEL_PATH=

# ── Vector Store (ChromaDB) ───────────────────────────────────
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=documents

# ── Chat History Database ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/chat_history.db

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT=30/minute

# ── Document Storage ──────────────────────────────────────────
UPLOAD_DIR=./data/uploads

# ── Chunking ──────────────────────────────────────────────────
CHUNK_SIZE=512                 # words per chunk
CHUNK_OVERLAP=64               # overlapping words between chunks
CHUNK_MIN_LENGTH=20            # drop chunks below this many words

# ── Retrieval ─────────────────────────────────────────────────
RETRIEVAL_TOP_K=5              # final context size fed to the LLM
RETRIEVAL_HYBRID=true          # combine semantic + BM25
RETRIEVAL_SEMANTIC_WEIGHT=0.7  # semantic share of the hybrid fusion
SIMILARITY_THRESHOLD=0.30      # min cosine similarity for semantic hits
MIN_CONTEXT_CHUNKS=1
METADATA_FILTER_ENABLED=false

# ── Re-ranking ────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=true
RERANK_TOP_K=8                 # candidates passed to the reranker

# ── Guardrails / Confidence ───────────────────────────────────
LOW_CONFIDENCE_THRESHOLD=0.40
REFUSAL_MESSAGE=I don't have enough information in the provided documents to answer this reliably.
MAX_CONTEXT_CHARS=12000

# ── Hallucination detection ───────────────────────────────────
HALLUCINATION_CHECK_ENABLED=true
HALLUCINATION_MIN_OVERLAP=2    # min keyword overlap to consider a claim grounded

# ── Evaluation / release gating ───────────────────────────────
EVALUATION_DATASET=evaluation/dataset.json
EVALUATION_THRESHOLDS=evaluation/thresholds.yaml
EVALUATION_REPORT_DIR=evaluation/reports
EVALUATION_LLM_JUDGE=false     # use RAGAS/LLM judge metrics when configured

# ── Firebase Auth (Optional) ──────────────────────────────────
FIREBASE_CREDENTIALS_PATH=

# ── Neo4j Graph Database ──────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-password
NEO4J_DATABASE=neo4j